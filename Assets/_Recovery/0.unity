  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EncuentroEstrella
  controlDuo: {fileID: 880000005}
  hablantes:
  - Sol
  - Estrella
  - Sol
  - Estrella
  lineas:
  - "Estrella, te encontr\xE9. \xBFEst\xE1s bien?"
  - "\xA1Sol! Pensaba que no llegabas. Esta compuerta tiene tres candados."
  - Yo puedo empujar la caja pesada y mover la palanca.
  - "Y yo puedo saltar hasta la llave. \xA1Vamos juntos!"
  retardoAntesDeHablar: 0.35
  mensajeFinal: "Estrella se uni\xF3 al equipo. Pulsa TAB para cambiar de personaje."
